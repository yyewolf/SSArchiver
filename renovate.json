{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "3 days",
  "prHourlyLimit": 2,
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Auto-merge patch and minor updates once CI is green",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "description": "Group GitHub Actions updates and auto-merge them",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "automerge": true
    },
    {
      "description": "Keep the golangci-lint pin in sync across Makefile and CI",
      "matchManagers": ["regex"],
      "matchDepNames": ["golangci/golangci-lint"],
      "groupName": "golangci-lint",
      "automerge": true
    },
    {
      "description": "Major updates wait for approval on the dependency dashboard",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "golangci-lint pinned in the Makefile",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": [
        "go run github\\.com/golangci/golangci-lint/v2/cmd/golangci-lint@(?<currentValue>v[0-9.]+)"
      ],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "golangci-lint version pinned in CI",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["version: (?<currentValue>v[0-9.]+)"],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases"
    }
  ]
}
